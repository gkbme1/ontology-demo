# ===== LLM（OpenAI 兼容接口；换模型只改这几行，代码零改动）=====
# 本地 vLLM 示例：LLM_BASE_URL=http://127.0.0.1:8000/v1  LLM_API_KEY=EMPTY  LLM_MODEL=Qwen3-32B
# 注意：vLLM 必须开工具解析，否则收不到 tool_calls：
#   --enable-auto-tool-choice --tool-call-parser hermes
# 千问 3 若开着 thinking 模式，思维链会内联在 content 里；本 Demo 会自动剥掉 <think> 标签，
# 但更省 token 的做法是直接关掉（chat template 传 enable_thinking=false）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_STREAM=true
# 思考模式开关（千问 3 / 3.6 等混合思考模型）。留空 = 不传，沿用服务端默认；
# false = 关闭思考，回答前不再生成思维链，耗时明显缩短。服务端不认识该参数时请留空。
LLM_ENABLE_THINKING=

# ===== 6-APA 本体 REST API =====
ONTOLOGY_BASE_URL=http://localhost:8700
ONTOLOGY_TIMEOUT=20

# ===== 模型档位（换模型主要改这一行）=====
# cloud     云端长上下文模型（DeepSeek / GPT 等）：一次下发全部 34 个工具
# local32k  本地 32k 上下文模型（如千问 32B）：只先发 10 个核心工具，其余由模型按需取用；
#           同时收紧单轮工具次数与返回体，避免工艺调查走到一半撑爆上下文
# local128k 本地模型 + YaRN 扩到 128k：介于两者之间
LLM_PROFILE=cloud

# 下面五项留空即按档位自动取值；显式填了就以你填的为准。
# 档位对照（cloud / local32k / local128k）：
#   MAX_TOOL_CALLS_PER_TURN   15 /  8 / 12
#   MAX_TOOL_RESULT_CHARS  10000 / 4000 / 8000
#   MAX_HISTORY_MESSAGES      40 / 24 / 32
#   MAX_CONTEXT_CHARS      90000 / 20000 / 80000
#   PROGRESSIVE_TOOLS      false / true / true
MAX_TOOL_CALLS_PER_TURN=
MAX_HISTORY_MESSAGES=
MAX_TOOL_RESULT_CHARS=
MAX_CONTEXT_CHARS=
# 渐进解锁：只先下发核心工具，模型自己调 list_available_tools 取其余的
PROGRESSIVE_TOOLS=
# 关系查询默认走精简视图（一条约 300 字节而不是 1.8 KB）
COMPACT_RELATIONS=

# ===== Agent 服务 =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8800
# 逗号分隔；* 表示不限制
CORS_ORIGINS=*

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=./logs

# ===== 模拟 DCS 数据服务（实时值 / 历史值，返回模拟数据）=====
MOCK_DCS_PORT=8900
# 点表来源；不填则沿用 ONTOLOGY_BASE_URL
MOCK_DCS_ONTOLOGY_URL=
# true：点表里查不到的 nodeId 返回 q=0/v=null；false：按位号名推断生成
MOCK_DCS_STRICT_NODES=false
MOCK_DCS_SEED=6apa
MOCK_DCS_MAX_NODES=500
MOCK_DCS_MAX_POINTS=10000
MOCK_DCS_TZ_OFFSET=8
