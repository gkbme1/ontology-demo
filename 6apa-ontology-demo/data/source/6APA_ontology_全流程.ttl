@prefix :     <http://pharma.ontology.org/antibiotics/6apa#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://pharma.ontology.org/antibiotics/6apa> a owl:Ontology ; rdfs:label '6-APA车间全流程工业本体 v2'@zh .

# === 1. 类 (Classes) ===
:ProductionArea a owl:Class ; rdfs:label '生产工段'@zh .
:ProductionEquipment a owl:Class ; rdfs:label '生产设备'@zh .
:EquipmentInstance a owl:Class ; rdfs:label '设备实例'@zh .
:EquipmentComponent a owl:Class ; rdfs:label '设备部件'@zh .
:MaterialStream a owl:Class ; rdfs:label '物料流股'@zh .
:UtilityMedium a owl:Class ; rdfs:label '公用介质'@zh .
:ProcessAttribute a owl:Class ; rdfs:label '工艺属性'@zh .
:QualityKPI a owl:Class ; rdfs:label '质量指标'@zh .
:BusinessKPI a owl:Class ; rdfs:label '业务指标'@zh .
:Controller a owl:Class ; rdfs:label '控制仪表'@zh .
:Actuator a owl:Class ; rdfs:label '执行机构'@zh .
:ControlSystem a owl:Class ; rdfs:label '控制系统'@zh .
:AlarmEvent a owl:Class ; rdfs:label '报警事件'@zh .
:DcsTag a owl:Class ; rdfs:label 'DCS测点'@zh .
:EquipmentInstance rdfs:subClassOf :ProductionEquipment .
:UtilityMedium rdfs:subClassOf :MaterialStream .
:QualityKPI rdfs:subClassOf :ProcessAttribute .
:BusinessKPI rdfs:subClassOf :ProcessAttribute .

# === 2. 对象属性 (Object Properties) ===
:hasEquipment a owl:ObjectProperty ; rdfs:label '包含设备'@zh .
:hasMember a owl:ObjectProperty ; rdfs:label '包含实例'@zh .
:hasPart a owl:ObjectProperty ; rdfs:label '具有部件'@zh .
:hasAttribute a owl:ObjectProperty ; rdfs:label '具有属性'@zh .
:boundToTag a owl:ObjectProperty ; rdfs:label '绑定测点'@zh .
:controls a owl:ObjectProperty ; rdfs:label '控制'@zh .
:feedbackTo a owl:ObjectProperty ; rdfs:label '反馈给'@zh .
:isControlledBy a owl:ObjectProperty ; rdfs:label '被控制'@zh .
:triggersAlarm a owl:ObjectProperty ; rdfs:label '触发报警'@zh .
:flowsInto a owl:ObjectProperty ; rdfs:label '流入'@zh .
:injectedInto a owl:ObjectProperty ; rdfs:label '注入'@zh ; rdfs:subPropertyOf :flowsInto .
:dosedInto a owl:ObjectProperty ; rdfs:label '滴加入'@zh ; rdfs:subPropertyOf :flowsInto .
:recyclesTo a owl:ObjectProperty ; rdfs:label '循环返回'@zh ; rdfs:subPropertyOf :flowsInto .
:suppliesUtility a owl:ObjectProperty ; rdfs:label '供给介质'@zh .
:produces a owl:ObjectProperty ; rdfs:label '产出'@zh .
:separatesInto a owl:ObjectProperty ; rdfs:label '分离产出'@zh ; rdfs:subPropertyOf :produces .
:connectedToNext a owl:ObjectProperty ; rdfs:label '串联下游'@zh .
:positivelyAffects a owl:ObjectProperty ; rdfs:label '正向影响'@zh ; rdfs:subPropertyOf :affects .
:negativelyAffects a owl:ObjectProperty ; rdfs:label '负向影响'@zh ; rdfs:subPropertyOf :affects .
:affects a owl:ObjectProperty ; rdfs:label '影响'@zh .
:isControlledBy owl:inverseOf :controls .
:hasComponent owl:equivalentProperty :hasPart .

:processSection a owl:DatatypeProperty ; rdfs:label '所属工艺工段'@zh .
:confidence a owl:AnnotationProperty .

