# 本体服务地址；留空则走 vite.config.ts 中的 /api 代理
VITE_API_BASE=

# 开发期 /api 代理的目标（后端地址）。后端默认端口 8700
VITE_API_PROXY=http://localhost:8700

# Agent 服务地址（「固定工具」页读取工具清单）；留空则走 /agent-api 代理
VITE_AGENT_BASE=
# 开发期 /agent-api 代理的目标。Agent 默认端口 8800
VITE_AGENT_PROXY=http://localhost:8800

# 前端开发服务器端口
VITE_DEV_PORT=5173
